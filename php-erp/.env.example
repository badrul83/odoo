APP_ENV=local
APP_DEBUG=false
APP_BASE_URL=http://localhost
APP_TIMEZONE=Asia/Dhaka
# Passkeys require the exact site origin and relying-party domain. For cPanel,
# set these to the public HTTPS site (for example, erp.example.com and
# https://erp.example.com). Keep localhost for local XAMPP development.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost
# Optional; configure an absolute writable path outside the public document root.
# ERP_STORAGE_PATH=/home/account/private/erp-storage
ERP_DB_HOST=127.0.0.1
ERP_DB_PORT=3306
ERP_DB_NAME=erp_database
ERP_DB_USER=erp_user
ERP_DB_PASSWORD=replace_with_a_strong_password
ERP_DATA_ENCRYPTION_KEY=generate_with_openssl_rand_base64_32_and_keep_private
